# Application
APP_ENV=development
APP_VERSION=local
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMMIT_SHA=

# Database and authentication
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=replace-with-a-long-random-secret
MOBILE_SECRET=replace-with-a-server-only-secret
EXPO_PUBLIC_MOBILE_SECRET=public-client-identifier-only

# Email, weather and scheduled jobs
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPENWEATHER_API_KEY=
CRON_SECRET=replace-with-a-long-random-secret

# Sentry (optional until a NovaChrono project is provisioned)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Mobile
EXPO_PUBLIC_BASE_URL=http://localhost:3000
